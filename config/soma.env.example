# Optional: `auto` selects the connected OBSBOT by name. Use explicit IDs from
# `swift run soma-probe --list-formats` only for a multi-camera setup.
SOMA_VIDEO_ID=auto
SOMA_AUDIO_ID=auto

# Required for L1 situation reasoning. Start Ollama and make this exact model
# available with `ollama pull gemma4:31b-cloud` before installing the runtime.
OLLAMA_HOST=http://127.0.0.1:11434
SOMA_L1_MODEL=gemma4:31b-cloud
SOMA_L0_EYE_CONTACT_FRESHNESS_MS=450
SOMA_L0_CAMERA_VERTICAL_PLACEMENT=eye_level

# Optional: enables hosted web search/fetch used by L1 curiosity collection.
# OLLAMA_API_KEY=

# Safe default: perception and conversation may run, but physical motion is off.
SOMA_ENABLE_MOTION=0

# Set these only after calibrating the connected camera and gimbal.
# SOMA_CAMERA_GEOMETRY_CALIBRATION=/absolute/path/to/camera-geometry.json
# SOMA_EXTERNAL_GIMBAL_CALIBRATION=/absolute/path/to/external-gimbal-calibration.json
# SOMA_GEOMETRY_PYTHON="$HOME/Library/Application Support/SOMA/venvs/l05/bin/python"

# Optional runtime components.
SOMA_ENABLE_L2_LIVE_VOICE=1
# Optional override. Normally SOMA discovers the CLI from PATH or any installed
# application bundle (including Codex.app and ChatGPT.app) that embeds it.
# SOMA_CODEX_BINARY=/absolute/path/to/codex
# Optional explicit override; otherwise SOMA discovers a local Hermes CLI.
# SOMA_HERMES_BINARY="$HOME/.local/bin/hermes"
SOMA_ENABLE_L05_VLM=0
# SOMA_L05_VLM_PYTHON="$HOME/Library/Application Support/SOMA/venvs/l05/bin/python"
# SOMA_L05_VLM_MODEL="$HOME/Library/Application Support/SOMA/models/gemma-4-e2b-it-4bit"
